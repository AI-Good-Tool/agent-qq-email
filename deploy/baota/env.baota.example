# 复制为项目根目录的 .env.baota 后修改。不要把真实密码提交到代码仓库。
SITE_ORIGIN=https://mail.example.com
WEB_PORT=1265
API_PORT=7101

# 首次部署可以保留默认值，正式使用前建议修改密码。
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=abadmin123ab

# 留空时 Egg.js 会在 server/data/dashboard-token.secret 自动生成并持久化随机密钥。
DASHBOARD_TOKEN_SECRET=

AGENTLY_WORKSPACE=codex
AGENTLY_CLI_PATH=agently-cli
