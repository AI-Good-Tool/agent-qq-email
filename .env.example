# 云邮盒配置。复制为项目根目录的 .env 后修改（一键安装脚本会自动生成）。

# 监听地址：127.0.0.1 = 仅本机（配合宝塔网站反向代理，推荐）；0.0.0.0 = 允许用 IP:端口 直接访问
HOST=127.0.0.1
PORT=1265

# 控制台登录账号。正式使用前务必修改密码。
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=abadmin123ab
# 留空时首次启动自动生成并保存在 data/dashboard-token.secret
DASHBOARD_TOKEN_SECRET=
# 登录有效期（天）
TOKEN_TTL_DAYS=30

# 腾讯 Agent Mail 官方 CLI。宝塔环境建议写绝对路径，例如 /www/server/nodejs/v22.14.0/bin/agently-cli
AGENTLY_CLI_PATH=agently-cli
# Node.js 所在目录（agently-cli 依赖 node），多个目录用冒号分隔
EXTRA_PATH=
# CLI 单次调用超时（秒）
AGENTLY_TIMEOUT=30
# 可选：首次启动时导入的已有 CLI 工作区名称（旧版默认是 codex），留空则直接扫码添加
AGENTLY_WORKSPACE=

# 数据目录（SQLite 数据库、登录密钥），相对路径以项目根目录为基准
DATA_DIR=data
